// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                    Int                    @id @default(autoincrement())
  username              String                 @unique
  password              String
  forumPrivacySettings  String                 @default("{\"preset\":\"privacy\"}")
  studyLogs             StudyLog[]
  tasks                 Task[]
  pushSubscriptions     PushSubscription[]
  refreshTokens         RefreshToken[]
  posts                 Post[]
  comments              Comment[]
  postLikes             PostLike[]
  commentLikes          CommentLike[]
  studyGroups           StudyGroupMember[]
  createdGroups         StudyGroup[]         @relation("GroupCreator")
  forumNotifications    ForumNotification[]
}

model RefreshToken {
  id                 Int      @id @default(autoincrement())
  tokenId            String   @unique
  userId             Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  replacedByTokenId  String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StudyLog {
  id           Int     @id @default(autoincrement())
  date         String
  duration     Int
  content      String
  aiFeedback   String?
  sharedToWall Boolean @default(false)
  userId       Int
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([sharedToWall])
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  isDone      Boolean @default(false)
  dueTime         String?                  // HH:mm
  priority        Int?
  category        String?
  labels          String?                  // JSON
  repeatRule      String?                  // RRULE string
  repeatStartDate String?                  // YYYY-MM-DD
  repeatTimeZone  String?
  reminderTimes   String?                  // JSON (HH:mm array)
  plannedDate String? // 计划完成日期，格式 YYYY-MM-DD
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides   TaskOccurrenceOverride[]
  reminders   TaskReminderInstance[]

  @@index([plannedDate])
  @@index([repeatRule])
  @@index([userId])
}

model TaskOccurrenceOverride {
  id             Int      @id @default(autoincrement())
  taskId         Int
  occurrenceDate String   // YYYY-MM-DD
  overrideDate   String?  // YYYY-MM-DD
  title          String?
  description    String?
  dueTime        String?
  priority       Int?
  category       String?
  labels         String?  // JSON
  isCancelled    Boolean  @default(false)
  isDone         Boolean  @default(false)
  doneAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, occurrenceDate])
  @@index([occurrenceDate])
}

model TaskReminderInstance {
  id             Int      @id @default(autoincrement())
  taskId         Int
  occurrenceDate String   // YYYY-MM-DD
  remindAt       DateTime
  status         String   @default("pending")
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, occurrenceDate, remindAt])
  @@index([remindAt, status])
}

model PushSubscription {
  id             Int      @id @default(autoincrement())
  userId         Int
  endpoint       String   @unique
  keys           String   // JSON
  expirationTime String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  isAnonymous Boolean   @default(false)
  studyCard   String?   // JSON
  groupId     Int?
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       StudyGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  comments    Comment[]
  likes       PostLike[]
  notifications ForumNotification[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([groupId])
  @@index([createdAt])
}

model Comment {
  id          Int           @id @default(autoincrement())
  content     String
  isAnonymous Boolean       @default(false)
  postId      Int
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       CommentLike[]
  notifications ForumNotification[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId])
  @@index([userId])
}

model PostLike {
  id     Int  @id @default(autoincrement())
  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommentLike {
  id        Int     @id @default(autoincrement())
  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model StudyGroup {
  id          Int                 @id @default(autoincrement())
  name        String
  description String?
  tags        String?             // JSON
  creatorId   Int
  creator     User                @relation("GroupCreator", fields: [creatorId], references: [id])
  members     StudyGroupMember[]
  posts       Post[]
  notifications ForumNotification[]
  createdAt   DateTime            @default(now())

  @@index([creatorId])
}

model StudyGroupMember {
  id       Int        @id @default(autoincrement())
  groupId  Int
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   Int
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String     @default("member")
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ForumNotification {
  id               Int      @id @default(autoincrement())
  type             String
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedPost      Post?    @relation(fields: [relatedPostId], references: [id], onDelete: SetNull)
  relatedComment   Comment? @relation(fields: [relatedCommentId], references: [id], onDelete: SetNull)
  relatedGroup     StudyGroup? @relation(fields: [relatedGroupId], references: [id], onDelete: SetNull)
  relatedPostId    Int?
  relatedCommentId Int?
  relatedGroupId   Int?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([relatedPostId])
  @@index([relatedCommentId])
}
