# Backend environment (example)

DATABASE_URL="mysql://root:your_password@localhost:3306/chroma_study"

# JWT
JWT_ISSUER="chroma-study"
JWT_AUDIENCE="chroma-study-api"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Password hashing
BCRYPT_COST="10"

